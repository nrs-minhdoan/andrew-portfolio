  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
